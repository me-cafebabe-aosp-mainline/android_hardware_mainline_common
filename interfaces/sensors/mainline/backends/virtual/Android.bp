cc_library_shared {
    name: "libsensors_virtual",
    vendor: true,
    srcs: [
        "VirtualBackend.cpp",
        "VirtualSensorsService.cpp",
    ],
    header_libs: ["libsensors_mainline_headers"],
    static_libs: ["libsensors_common"],
    shared_libs: [
        "android.hardware.sensors-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libdl",
        "liblog",
        "vendor.mainline.sensors-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-fvisibility=hidden",
    ],
}
