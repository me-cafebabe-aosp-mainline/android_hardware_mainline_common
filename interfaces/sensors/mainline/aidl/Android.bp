// Interface between the virtual sensors backend of the mainline Sensors HAL
// (backends/virtual) and the settings app shipped in the same APEX. See
// IVirtualSensors.aidl.
//
// Frozen at version 1 (aidl_api/). To change it, see docs/HAL_APPS.md: set
// `frozen: false`, edit, run m vendor.mainline.sensors-update-api, and freeze
// the new version (m vendor.mainline.sensors-freeze-api) before it ships.
aidl_interface {
    name: "vendor.mainline.sensors",
    owner: "mainline",
    vendor_available: true,
    srcs: ["vendor/mainline/sensors/*.aidl"],
    stability: "vintf",
    frozen: true,
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
            apex_available: [
                "//apex_available:platform",
                "com.android.hardware.sensors.mainline",
            ],
        },
        ndk: {
            apex_available: [
                "//apex_available:platform",
                "com.android.hardware.sensors.mainline",
            ],
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
}

// The framework compatibility matrix entry for IVirtualSensors. The interface
// is optional: the framework never uses it, the entry only keeps VINTF checks
// from flagging the HAL as unknown.
vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.mainline.sensors.xml",
    stem: "compatibility_matrix.mainline.sensors.xml",
    srcs: ["compatibility_matrix.mainline.sensors.xml"],
    product_specific: true,
}
