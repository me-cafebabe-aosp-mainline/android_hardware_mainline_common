<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vendor.mainline.sensors.settings">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_virtual_sensors"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MainlineSensors">

        <activity
            android:name=".SensorsSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">

            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>

            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.system" />
            <!-- Inside System › Interaction, after Gestures. -->
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="interaction_category" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_virtual_sensors" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://vendor.mainline.sensors.settings.summary/getDynamicSummary" />
        </activity>

        <provider
            android:name=".SensorsSummaryProvider"
            android:authorities="vendor.mainline.sensors.settings.summary"
            android:exported="true" />

    </application>
</manifest>
