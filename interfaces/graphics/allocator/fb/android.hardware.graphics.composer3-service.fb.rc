service vendor.hwcomposer-3.fb /vendor/bin/hw/android.hardware.graphics.composer3-service.fb
    class hal animation
    interface aidl android.hardware.graphics.composer3.IComposer/default
    user system
    group graphics drmrpc
    capabilities SYS_NICE
    onrestart restart surfaceflinger
    task_profiles ServiceCapacityLow

on property:apex.com.android.hardware.graphics.allocator.ready=true
    start vendor.hwcomposer-3.fb
