# The name is the stock one on purpose: audioserver.rc restarts, starts and stops
# only these names together with audioserver. The HAL keeps what a client left
# behind (the connected remote submix port, patches), so after an audioserver
# restart (SurfaceFlinger or zygote crash) the new audioserver failed to load
# the r_submix module and ran without a policy manager until the HAL restarted.
service vendor.audio-hal-aidl /apex/com.android.hardware.audio/bin/hw/android.hardware.audio.service-aidl.mainline
    class hal
    user audioserver
    # audio: /dev/snd/*; media: /data/misc/media; the rest matches the example HAL
    group audio camera drmrpc inet media mediadrm net_bt net_bt_admin net_bw_acct wakelock context_hub
    capabilities BLOCK_SUSPEND SYS_NICE
    # setting RLIMIT_RTPRIO allows binder RT priority inheritance
    rlimit rtprio 10 10
    ioprio rt 4
    task_profiles ProcessCapacityHigh HighPerformance
    onrestart restart audioserver

# State the settings app sets through vendor.mainline.audio.IControl (mixer
# values, ...). init reads this file once /data is mounted (post-fs-data), so
# early-boot creates the directory before the hal class starts. apexd only sets
# apex.<name>.ready on a rebootless update, never at boot. Without the
# directory nothing is kept across restarts.
on early-boot
    mkdir /data/vendor/mainline_audio 0770 audioserver audio

on property:apex.com.android.hardware.audio.ready=true
    start vendor.audio-hal-aidl
