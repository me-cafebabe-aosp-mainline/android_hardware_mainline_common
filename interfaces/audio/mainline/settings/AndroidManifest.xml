<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="vendor.mainline.audio.settings">

    <!-- No privileged permission: Android grants none to a vendor app, and
         requesting one without an allowlist entry stops the system at boot.
         Default devices are the job of MainlineAudioRouting (routing/). -->

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_audio_devices"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MainlineAudio">

        <activity
            android:name=".AudioSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">

            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>

            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <!-- Inside Sound › Audio, after Default audio devices (-106) and Now
                 Playing (-105). -->
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="audio_category" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-104" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_audio_devices" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
        </activity>

    </application>
</manifest>
