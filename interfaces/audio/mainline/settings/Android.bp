// Settings app of the mainline audio HAL, see README.md. It ships inside the
// HAL's APEX, which makes it a vendor app: it is built against the module SDK
// (no hidden APIs, no platform certificate), it must not request privileged
// permissions (Android grants a vendor app none that lack vendorPrivileged),
// and its SELinux domain comes from the device's vendor policy.
android_app {
    name: "MainlineAudioSettings",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    // ServiceManager.waitForDeclaredService() for IControl. Privileged only so
    // that the vendor seapp_contexts entry matches the preinstalled app alone.
    sdk_version: "module_current",
    privileged: true,

    static_libs: [
        "MainlineAudioSettingsCommon",
        "androidx.lifecycle_lifecycle-runtime-ktx",
        "androidx.lifecycle_lifecycle-viewmodel-ktx",
        "kotlinx_coroutines_android",
        "vendor.mainline.audio-V2-java",
    ],

    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },

    apex_available: ["com.android.hardware.audio.mainline"],
}
